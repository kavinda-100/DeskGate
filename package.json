{
  "name": "deskgate",
  "version": "1.0.0",
  "description": "DeskGate is a learning-focused SaaS project designed to demonstrate how a web application can sell, authenticate, license, and control access to a desktop application.",
  "type": "module",
  "private": true,
  "keywords": [
    "monorepo",
    "pnpm",
    "typescript"
  ],
  "author": "Kavinda Rathnayake",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "ts-add-js-extension": "^1.6.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
