{
  "name": "deskgate",
  "version": "1.0.0",
  "description": "DeskGate is a learning-focused SaaS project designed to demonstrate how a web application can sell, authenticate, license, and control access to a desktop application.",
  "type": "module",
  "private": true,
  "keywords": [
    "monorepo",
    "pnpm",
    "typescript"
  ],
  "author": "Kavinda Rathnayake",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "start": "pnpm --parallel --filter \"./apps/*\" start",
    "predev": "pnpm --filter \"./packages/*\" build",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "db:generate": "pnpm --filter @deskgate/database db:generate",
    "db:push": "pnpm --filter @deskgate/database db:push",
    "db:studio": "pnpm --filter @deskgate/database db:studio",
    "db:reset": "pnpm --filter @deskgate/database db:reset",
    "db:schema:generate": "pnpm --filter @deskgate/schemas build && pnpm --filter @deskgate/api db:schema:generate",
    "stripe:webhook": "stripe listen --forward-to localhost:5000/api/auth/stripe/webhook",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"**/*.{ts,tsx,js,json}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "ts-add-js-extension": "^1.6.6",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.65.0"
  }
}
