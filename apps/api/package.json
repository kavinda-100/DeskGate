{
  "name": "@deskgate/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json --noEmit false && ts-add-js-extension --dir=dist",
    "db:schema:generate": "pnpm dlx auth@latest generate --config ./src/auth/auth.ts --output ../../packages/database/prisma/schema.prisma --yes"
  },
  "dependencies": {
    "@better-auth/stripe": "^1.6.25",
    "@deskgate/database": "workspace:*",
    "@deskgate/schemas": "workspace:*",
    "better-auth": "^1.6.25",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "find-config": "^1.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/find-config": "^1.0.4",
    "@types/node": "^26.1.2",
    "ts-add-js-extension": "^1.6.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
